# --- Required (provided by Syntax) -------------------------------------------
OPENAI_API_KEY=replace-with-your-litellm-proxy-key
OPENAI_BASE_URL=https://your-litellm-proxy.example
OPENAI_MODEL=your-allowed-chat-model
OPENAI_EMBEDDING_MODEL=your-allowed-embedding-model
# Note: OPENAI_BASE_UR (spelling used in the Syntax package) is accepted too,
# and surrounding quotes are stripped (docker --env-file keeps them verbatim).

# --- Optional tuning (defaults shown) -----------------------------------------
# RETRIEVAL_TOP_K=5          passages per initial search
# CHUNK_MAX_CHARS=1500       chosen by scripts/eval_retrieval.py
# RRF_K=60                   reciprocal-rank-fusion constant
# MAX_EVIDENCE=30            passages given to the writer/critic
# MAX_AGENT_TURNS=4          tool-calling turns per round
# MAX_TOOL_CALLS=8           tool calls per round
# MAX_CRITIC_RETRIES=1       critic-driven revision loops
# LLM_TIMEOUT_S=90
# LOG_LEVEL=INFO
# PERSIST_TRACES=true        write data/traces/<trace_id>.json
