    {
      "name": "vitamin_b12",
      "rationale": "Lost subscript: 'vitamin B 12' -> 'vitamin B12'."
    },
    {
      "name": "colon_spacing",
      "rationale": "Label glued to its value: 'Liver warning:This' -> 'Liver warning: This'."
    },
    {
      "name": "bullet_normalization",
      "rationale": "Unicode bullets -> Markdown list items so the chunker keeps lists intact."
    },
    {
      "name": "trailing_whitespace",
      "rationale": "Invisible trailing spaces."
    },
    {
      "name": "blank_line_runs",
      "rationale": "Collapse runs of blank lines (paragraph boundaries are preserved)."
    }
