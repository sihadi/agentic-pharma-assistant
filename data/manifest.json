      "name": "unit_m2",
      "rationale": "Lost superscript in body-surface units: 'mL/min/1.73 m 2' -> 'm²'."
    },
    {
      "name": "vitamin_b12_glued",
      "rationale": "Lost subscript glued to next word: 'B 12Deficiency' -> 'B12 Deficiency'."
